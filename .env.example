# Copy this file to .env (already gitignored) and fill in real values.
# Never commit .env - see CLAUDE.md rule 2.

# A bcrypt hash of your chosen password, not the password itself. Generate
# one using the image you've already built, so you don't need Python on the
# host at all:
#   docker compose run --rm notes-interface python -c "import bcrypt,sys; print(bcrypt.hashpw(sys.argv[1].encode(), bcrypt.gensalt()).decode())" "YourChosenPassword"
#
# IMPORTANT: a bcrypt hash looks like $2b$12$<salt+hash> - Compose
# interpolates `$something` in .env files, so every one of those dollar
# signs must be doubled to `$$` or Compose silently blanks out the pieces
# it thinks are undefined variables (the container gets a corrupted hash,
# and every login attempt fails with no indication why). Take the hash
# exactly as printed and double every $ before pasting it in below.
# Example: $2b$12$abc...  becomes  $$2b$$12$$abc...
PASSWORD_HASH=

# Any long random string - signs the session cookie. Generate one with:
#   docker compose run --rm notes-interface python -c "import secrets; print(secrets.token_hex(32))"
# (No $ characters in this one, so no escaping needed here.)
SECRET_KEY=

# Optional. When both are set, "Keep in vault" on a recipe also pushes it
# to a self-hosted Tandoor instance. Leave both blank to skip this
# entirely - nothing else here depends on it, and a failed/unreachable
# Tandoor never blocks filing the note (see backend/app/tandoor.py).
#
# NOTE: verified 2026-08-21 against a live Tandoor instance. If recipes
# still aren't showing up in Tandoor after this is configured, check the
# container logs right after a "Keep in vault" on a recipe - the log line
# includes Tandoor's response.
TANDOOR_URL=
TANDOOR_API_TOKEN=

# Optional. When both are set, "Keep in vault" on a movie or TV note also
# requests it in a self-hosted Seerr instance, so it shows up in your
# Radarr/Sonarr queue. Leave both blank to skip this entirely - same
# best-effort, never-blocks-filing behavior as Tandoor above (see
# backend/app/seerr.py). Only requests when enrichment found a year to
# confirm the match against - no year means it skips rather than guessing
# and requesting the wrong title.
#
# NOTE: built from Seerr's public API docs, not verified against a live
# instance. Check the container logs after a "Keep in vault" on a movie or
# show if nothing shows up in Seerr.
SEERR_URL=
SEERR_API_KEY=

# Required for the "chat about this item" feature on item detail. This is
# the one deliberate exception to "the interface never calls the Gemini
# API" (PROJECT.md 3.3) - a live conversation needs a synchronous reply,
# which the processor's file-based, every-5-minute pipeline can't give.
#
# Same key material as gemini.key.xml, just also readable by this
# container - not a separate key, same billing/quota either way. The
# DPAPI file itself can't be used here: it only decrypts for the one
# Windows user and machine that created it, and this runs in Linux inside
# Docker. Get the plaintext key value the same way you'd read it for any
# other use, and paste it in below (no $ characters expected, but if the
# key ever contains one, double it - see the PASSWORD_HASH note above).
GEMINI_API_KEY=

# Optional. Defaults to gemini-3.5-flash (the same model enrichment uses)
# if left blank.
GEMINI_CHAT_MODEL=
